@api_router.post("/upload-video", response_model=VideoUploadResponse)
async def upload_video(file: UploadFile = File(...)):
    allowed_extensions = [".mp4", ".avi", ".mov", ".gif"]
    file_extension = Path(file.filename).suffix.lower()
    if file_extension not in allowed_extensions:
        raise HTTPException(status_code=400, detail="Unsupported file type")

    video_id = str(uuid.uuid4())

    # ✅ Cross-platform upload folder (works on Windows, macOS, Linux)
    upload_dir = ROOT_DIR / "uploads"
    upload_dir.mkdir(parents=True, exist_ok=True)

    temp_file_path = upload_dir / f"{video_id}{file_extension}"
    with open(temp_file_path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    async with aiosqlite.connect(DATABASE_PATH) as db:
        await db.execute("""
            INSERT INTO videos (video_id, filename, content_type, file_path, upload_timestamp, status)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            video_id, file.filename, file.content_type,
            str(temp_file_path), datetime.now(timezone.utc).isoformat(), "uploaded"
        ))
        await db.commit()

    return VideoUploadResponse(
        video_id=video_id,
        message="Video uploaded successfully",
        filename=file.filename
    )


@api_router.post("/analyze-video/{video_id}", response_model=VideoAnalysisResult)
async def analyze_video(video_id: str):
    async with aiosqlite.connect(DATABASE_PATH) as db:
        async with db.execute("SELECT * FROM videos WHERE video_id = ?", (video_id,)) as cursor:
            video_row = await cursor.fetchone()

    if not video_row:
        raise HTTPException(status_code=404, detail="Video not found")

    columns = ['video_id', 'filename', 'content_type', 'file_path', 'upload_timestamp', 'status', 'analysis_id']
    video_doc = dict(zip(columns, video_row))
    video_path = video_doc["file_path"]

    frames = extract_frames(video_path, fps=0.5)
    if not frames:
        raise HTTPException(status_code=400, detail="Could not extract frames from video")

    cap = cv2.VideoCapture(video_path)
    fps = cap.get(cv2.CAP_PROP_FPS)
    frame_count = cap.get(cv2.CAP_PROP_FRAME_COUNT)
    duration = frame_count / fps if fps > 0 else 0
    cap.release()

    detections = []
    for frame, timestamp in frames:
        detection = await analyze_frame_with_gemini(frame, timestamp)
        detections.append(detection)
        await asyncio.sleep(0.1)

    summary = {category: 0 for category in DETECTION_CATEGORIES}
    for detection in detections:
        if detection.category in summary:
            summary[detection.category] += 1

    analysis_result = VideoAnalysisResult(
        video_filename=video_doc["filename"],
        total_duration=duration,
        detections=detections,
        summary=summary,
        processed_frames=len(frames)
    )

    async with aiosqlite.connect(DATABASE_PATH) as db:
        detections_json = json.dumps([d.model_dump() for d in detections])
        summary_json = json.dumps(summary)

        await db.execute("""
            INSERT INTO analyses (id, video_id, video_filename, total_duration, analysis_timestamp,
                                  processed_frames, summary, detections)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            analysis_result.id, video_id, analysis_result.video_filename,
            analysis_result.total_duration, analysis_result.analysis_timestamp.isoformat(),
            analysis_result.processed_frames, summary_json, detections_json
        ))

        await db.execute("""
            UPDATE videos SET status = ?, analysis_id = ? WHERE video_id = ?
        """, ("analyzed", analysis_result.id, video_id))

        await db.commit()

    return analysis_result

@api_router.get("/analysis/{analysis_id}", response_model=VideoAnalysisResult)
async def get_analysis(analysis_id: str):
    async with aiosqlite.connect(DATABASE_PATH) as db:
        async with db.execute("SELECT * FROM analyses WHERE id = ?", (analysis_id,)) as cursor:
            analysis_row = await cursor.fetchone()

    if not analysis_row:
        raise HTTPException(status_code=404, detail="Analysis not found")

    columns = ['id', 'video_id', 'video_filename', 'total_duration', 'analysis_timestamp',
               'processed_frames', 'summary', 'detections']
    analysis_doc = dict(zip(columns, analysis_row))

    summary = json.loads(analysis_doc['summary'])
    detections_data = json.loads(analysis_doc['detections'])
    detections = [DetectionResult(**d) for d in detections_data]
    analysis_timestamp = datetime.fromisoformat(analysis_doc['analysis_timestamp'])

    return VideoAnalysisResult(
        id=analysis_doc['id'],
        video_filename=analysis_doc['video_filename'],
        total_duration=analysis_doc['total_duration'],
        analysis_timestamp=analysis_timestamp,
        detections=detections,
        summary=summary,
        processed_frames=analysis_doc['processed_frames']
    )

